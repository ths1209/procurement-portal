# 复制此文件为 .env.local，填入你的 Teable 配置
# Teable 控制台 → 个人设置 → API Token

# Teable API 地址（云端默认，自部署则改为你的域名）
VITE_TEABLE_API_BASE=https://app.teable.io

# Teable 个人 API Token（Settings → API Token → 创建）
VITE_TEABLE_TOKEN=your_teable_api_token_here

# 用户表的 Table ID（打开表格，URL 中 /table/ 后面的 ID）
VITE_TEABLE_USERS_TABLE_ID=tblXXXXXXXXXXXXXX

# 项目进度表 Table ID
VITE_TEABLE_PROJECTS_TABLE_ID=tblXXXXXXXXXXXXXX

# 百宝箱工具表 Table ID（存储文件附件，需在 Teable 新建一张空白表）
VITE_TEABLE_TOOLS_TABLE_ID=tblXXXXXXXXXXXXXX

# 百万项目评审表 Table ID（新建空白表，字段自动对应）
VITE_TEABLE_REVIEWS_TABLE_ID=tblXXXXXXXXXXXXXX

# 咨询赋能台账表 Table ID
VITE_TEABLE_CONSULTING_TABLE_ID=tblXXXXXXXXXXXXXX

# 访问统计表 Table ID（字段：用户ID / 姓名 / 页面 / 日期 / 访问时间，均为单行文本）
VITE_TEABLE_ANALYTICS_TABLE_ID=tblXXXXXXXXXXXXXX

# AI 需求池表 Table ID（字段自动创建）
VITE_TEABLE_AI_TABLE_ID=tblXXXXXXXXXXXXXX

# ========== 100tal SSO 扫码登录（可选）==========
# 两个变量同时配置才会启用扫码 Tab；缺失任一则隐藏扫码登录入口
# 1) 向 100tal SSO 申请的 appid
VITE_SSO_APPID=your_appid
# 2) Cloudflare Worker pp-sso 的公网地址（见 workers/README.md）
VITE_SSO_WORKER_BASE=https://pp-sso.xxx.workers.dev
