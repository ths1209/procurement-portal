# 复制此文件为 .env.local 并填入你的后端地址
# 所有 Teable Token / AI Key / Webhook 均由后端 FC 持有，前端不再保存任何密钥。

# ========== 后端 FC 基地址 ==========
# 负责 /auth /t /ai /notify /sso 全部业务代理。
VITE_API_BASE=https://pp-sso.example.cn-beijing.fcapp.run

# ========== 100tal SSO 扫码登录 ==========
# 向 100tal SSO 申请的 appid（非敏感，写入前端即可）
VITE_SSO_APPID=your_appid
# 与 VITE_API_BASE 相同（保留以兼容旧的 SSO 扫码路径）
VITE_SSO_WORKER_BASE=https://pp-sso.example.cn-beijing.fcapp.run
